# Django
DJANGO_SECRET_KEY="your-secret-key-here"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: SQLite is the local-development default.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# For MySQL, set DB_ENGINE=django.db.backends.mysql and provide these values.
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# React development server(s), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False

# Gemini
GEMINI_API_KEY="your-gemini-key-here"
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30

ANTHROPIC_API_KEY=
MAP_API_KEY=
WEATHER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
